+		(void)ioread32(ar_pci->mem + offset + 4);
+		(void)ioread32(ar_pci->mem + offset + 4);
+		iowrite32(value, ar_pci->mem + offset);
+		spin_unlock_irqrestore(&ar_pci->hw_v1_workaround_lock, irq_flags);
+	} else {
+		iowrite32(value, ar_pci->mem + offset);
